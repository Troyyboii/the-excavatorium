# The Excavatorium — public client configuration
# These are safe to commit. Do NOT put service-role keys, database
# passwords, JWT signing secrets, SMTP credentials, OAuth secrets,
# private API keys, wrapping keys, or GitHub tokens in this file or in
# any browser / VITE_* variable.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# ---------------------------------------------------------------------------
# Server-only (Supabase Edge secrets / MCP host). Never prefix with VITE_.
# Documented here so operators know what is NOT a browser env var.
# ---------------------------------------------------------------------------
# PROVIDER_KEY_ENCRYPTION_KEYS={"1":"<base64-32-bytes>"}
# PROVIDER_KEY_ACTIVE_VERSION=1
# CUSTODIAN_MODEL_PRICING_JSON={"gpt-5.6-luna":{...}, ...}   # six catalog models
# MCP_ALLOWED_CLIENT_IDS=<comma-separated-oauth-client-uuids>
# LOVABLE_PREVIEW_ORIGIN=https://<exact-preview-host>       # optional preview CORS
#
# Do NOT set OPENAI_API_KEY to fund Custodian, Conversation Excavation, or
# File Excavation for registered users. Those paths use owner BYOK only
# (encrypted via provider-key). An operator OpenAI key is not a supported
# production spend path in this beta.
